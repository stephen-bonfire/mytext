[Desktop Entry]
Name=MyText
Comment=Next generation markdown editor
Exec=mytext %F
Terminal=false
Type=Application
Icon=mytext
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=mytext;
StartupWMClass=mytext
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=mytext --new-window %F
Icon=mytext
